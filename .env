BOT_TOKEN=123456:YOUR_TELEGRAM_BOT_TOKEN

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Public HTTPS URL for Telegram Mini App, for example ngrok URL without trailing slash.
WEBAPP_PUBLIC_URL=

# Admin API secret for X-Admin-Secret.
ADMIN_SECRET=change-this-admin-secret

# Local browser development. Use false in production.
DEV_MODE=false

# SQLite file path.
DATABASE_PATH=founderpilot.sqlite3

# Optional access and anti-spam settings.
FREE_TRIAL_REQUESTS=20
SUBSCRIBER_MONTHLY_LIMIT=300
PER_MINUTE_LIMIT=6

# Telegram IDs allowed to use admin bot commands, comma-separated.
ADMIN_TELEGRAM_IDS=7851246214

# Server host/port.
HOST=
PORT=