# Telegram / OpenRouter
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
OPENROUTER_API_KEY=PASTE_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=openrouter/free
WEBAPP_PUBLIC_URL=https://your-app.up.railway.app
APP_SECRET=change-this-super-secret-string
ADMIN_SECRET=change-this-admin-secret
DEV_MODE=false
DEV_SKIP_TELEGRAM_AUTH=false
DATABASE_PATH=/app/data/founderpilot.sqlite3
HOST=0.0.0.0
PORT=8000

# Limits
DAILY_FREE_LIMIT=20
FREE_TRIAL_REQUESTS=20
SUBSCRIBER_MONTHLY_LIMIT=300
PER_MINUTE_LIMIT=6
PRO_DAILY_LIMIT=300
BUSINESS_DAILY_LIMIT=1500

# Billing switches
BILLING_ENABLE_STARS=true
BILLING_ENABLE_YOOKASSA=false
BILLING_ENABLE_TON=false
BILLING_ENABLE_BTCPAY=false

# Prices
PRO_PRICE_RUB=299
BUSINESS_PRICE_RUB=999
PRO_PRICE_STARS=299
BUSINESS_PRICE_STARS=999
PRO_PRICE_TON=3
BUSINESS_PRICE_TON=10
PRO_PRICE_BTC=0.00005
BUSINESS_PRICE_BTC=0.00015

# YooKassa / YooMoney
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# TON / Tonkeeper
TON_RECEIVER_ADDRESS=
TON_MANIFEST_URL=
TON_API_KEY=
TON_NETWORK=mainnet

# BTCPay Server / BTC
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
